@page
@model lab5.Pages.CVuploadModel
@{
    Random random = new Random();
    int dynamicNumber = random.Next(1, 100);
   
}

<div asp-validation-summary="All" class="danger"></div>

<form method="post" enctype="multipart/form-data" asp-route-randomNum="@dynamicNumber">
<label asp-for="ViewModel.FirstName"></label>
<input asp-for="ViewModel.FirstName" name="FirstName" />
    <span asp-validation-for="ViewModel.FirstName" data-valmsg-for="FirstName"></span>
<hr />

<label asp-for="ViewModel.LastName"></label>
<input asp-for="ViewModel.LastName" name="LastName" />
    <span asp-validation-for="ViewModel.LastName" data-valmsg-for="LastName"></span>
<hr />

<label asp-for="ViewModel.Birthday"></label>
<input asp-for="ViewModel.Birthday" name="Birthday" />
    <span asp-validation-for="ViewModel.Birthday" data-valmsg-for="Birthday"></span>
<hr />
<label asp-for="NationalitiesOptions"></label>
<select asp-items="@Model.NationalitiesOptions" asp-for="ViewModel.Nationalities"  name="Nationalities"></select>
<span asp-validation-for="ViewModel.Nationalities" data-valmsg-for="Nationalities"></span>
<hr />

<label> Gender</label>
    <input type="radio" asp-for="ViewModel.Gender" value="Male" name="Gender" /> Male
    <input type="radio" asp-for="ViewModel.Gender" value="Female" name="Gender" /> Female
    <br />
    <span asp-validation-for="ViewModel.Gender" data-valmsg-for="Gender"></span>

<hr />
    <label asp-for="ViewModel.Skills"></label>

    @*
            Loop through a list of predefined skills.
            Use "checked" attribute based on whether the skill is already selected (preserved on form re-render).
        *@
    @foreach (var skill in Model.SkillsOptions)
    {
        <div>
            <input type="checkbox" name="Skills" value="@skill" checked="@Model.ViewModel.Skills.Contains(skill)" /> @skill
        </div>
    }
    <br />
    <span asp-validation-for="ViewModel.Skills" data-valmsg-for="Skills"></span>
<hr />
    <label asp-for="ViewModel.Email"></label>
    <input asp-for="ViewModel.Email" name="Email" />
    <br />
    <span asp-validation-for="ViewModel.Email" data-valmsg-for="Email"></span>
<hr />
    <label asp-for="ViewModel.EmailConfirmation"></label>
    <input asp-for="ViewModel.EmailConfirmation" name="EmailConfirmation" />
    <br />
    <span asp-validation-for="ViewModel.EmailConfirmation" data-valmsg-for="EmailConfirmation"></span>
<hr />
    <label asp-for="ViewModel.Password"></label>
    <input asp-for="ViewModel.Password" name="Password" />
    <br />
    <span asp-validation-for="ViewModel.Password" data-valmsg-for="Password"></span>
<hr />
    <label>Sum of 2 randoms:</label>
    <input  asp-for="ViewModel.rand1" readonly />
    <br />
    <input  asp-for="ViewModel.rand2" readonly />
    <br />
    <input name="rsum" asp-for="ViewModel.rsum"  />
<hr />

<label asp-for="ViewModel.Image"></label>
<input asp-for="ViewModel.Image" name="Image"/>
<span asp-validation-for="ViewModel.Image" name="Image"></span>
<br />
<hr />
<button type="submit">submit</button>

</form>

@* Essential for Client Side Validations.*@
@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}





