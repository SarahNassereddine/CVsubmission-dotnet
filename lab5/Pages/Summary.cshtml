@page "{randomNum}/{id}"
@model lab5.Pages.SummaryModel
@{
}

<form>
    <ol>
        <li> First Name: @Model.CV.FirstName</li>
        <li> Last name: @Model.CV.LastName</li>
        <li> Birthday: @Model.CV.Birthday</li>

        <li> gender: @Model.CV.Gender </li>
        <li> email : @Model.CV.Email</li>
        <li> profile: <img src="@Model.CV.photoPath"></img> </li>

        <li> Skills: 
            <ul> @foreach (var skill in @Model.CV.Skills)
                    {
                        <li> @skill</li>
                    }
                </ul>
        </li>
         <li> Nationalities: 
            <ul> @foreach (var nationality in Model.CV.Nationalities)
                    {
                        <li> @nationality</li>
                    }
                </ul>
        </li>
        <li> Random number: @Model.randomNum</li>
    </ol>
</form>
