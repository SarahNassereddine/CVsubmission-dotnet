@page "{randomNum}/{token:guid}"
@model lab5.Pages.SummaryModel
@{
    ViewData["Title"] = "CV Summary";
}

<div class="container py-5" style="max-width:650px;">
    <div class="card shadow-sm">
        <div class="card-body p-4 text-center">
            <img src="@Model.CV.photoPath" class="rounded-circle mb-3 border" style="width:140px;height:140px;object-fit:cover;" />
            <h3 class="mb-0">@Model.CV.FirstName @Model.CV.LastName</h3>
            <p class="text-muted mb-4">@Model.CV.Email</p>

            <table class="table table-borderless text-start">
                <tbody>
                    <tr><th class="w-25">Birthday</th><td>@Model.CV.Birthday</td></tr>
                    <tr><th>Gender</th><td>@Model.CV.Gender</td></tr>
                    <tr>
                        <th>Skills</th>
                        <td>
                            @foreach (var skill in Model.CV.Skills)
                            {
                                <span class="badge bg-primary me-1">@skill</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Nationalities</th>
                        <td>
                            @foreach (var nationality in Model.CV.Nationalities)
                            {
                                <span class="badge bg-secondary me-1">@nationality</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            <a asp-page="Index" class="btn btn-outline-primary mt-2">Back to home</a>
        </div>
    </div>
</div>
