@page
@model lab5.Pages.AllCvsModel
@{
    ViewData["Title"] = "All CVs";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">All Submitted CVs <span class="badge bg-success">Admin</span></h2>
        <div class="d-flex gap-2">
            <a asp-page="CVupload" class="btn btn-primary">+ New CV</a>
            <a asp-page="Logout" class="btn btn-outline-danger">Logout</a>
        </div>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group" style="max-width:400px;">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    @if (Model.Cvs.Count == 0)
    {
        <p class="text-muted">No CVs found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var cv in Model.Cvs)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@cv.photoPath" class="card-img-top" style="height:180px;object-fit:cover;" />
                        <div class="card-body">
                            <h5 class="card-title">@cv.FirstName @cv.LastName</h5>
                            <p class="card-text text-muted mb-1">@cv.Email</p>
                            <div>
                                @foreach (var skill in cv.Skills)
                                {
                                    <span class="badge bg-primary me-1">@skill</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <a asp-page="Summary" asp-route-randomNum="0" asp-route-token="@cv.PublicToken" class="btn btn-sm btn-outline-primary w-100">View CV</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
